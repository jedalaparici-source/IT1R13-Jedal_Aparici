    <form>
      <input type="text" placeholder="Your Name" required>
      <input type="email" placeholder="Your Email" required>
      <textarea rows="5" placeholder="Your Message" required></textarea>
      <button type="submit">Send Message</button>
    </form>
  </section>

  <!-- ===== FOOTER ===== -->
  <footer>
    <p>© 2026 Jedal Aparici | Application Support Specialist</p>
    <p>
      <a href="https://github.com/jedalaparici-source/IT1R13-Jedal_Aparici" target="_blank">GitHub</a> |
      <a href="mailto:jedalaparici@gmail.com">Email</a>
    </p>
  </footer>

</body>
</html>
