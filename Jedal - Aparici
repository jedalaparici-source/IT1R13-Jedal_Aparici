<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Jedal Aparici | Application Support Specialist</title>
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@600;700&family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet">
  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    html {
      scroll-behavior: smooth;
      scroll-padding-top: 20px;
      scroll-padding-left: 220px;
    }

    body {
      font-family: 'Inter', sans-serif;
      color: #1a1a1a;
      padding-left: 200px;
      background:
        radial-gradient(circle at top right, rgba(201,169,106,0.06), transparent 40%),
        radial-gradient(circle at bottom left, rgba(27,74,122,0.05), transparent 40%),
        #f7f8fa;
      line-height: 1.6;
    }

    h1, h2, h3 {
      font-family: 'Playfair Display', serif;
      font-weight: 700;
      letter-spacing: 0.5px;
    }

    /* ===== SIDEBAR NAVIGATION ===== */
    nav {
      background: linear-gradient(180deg, #0f2c4c 0%, #1b4a7a 100%);
      position: fixed;
      top: 0;
      left: 0;
      width: 200px;
      height: 100vh;
      display: flex;
      flex-direction: column;
      justify-content: center;
      align-items: center;
      gap: 8px;
      z-index: 100;
      box-shadow: 4px 0 20px rgba(15, 44, 76, 0.15);
    }

    nav::before {
      content: "MENU";
      color: #c9a96a;
      font-family: 'Inter', sans-serif;
      font-size: 0.7rem;
      letter-spacing: 4px;
      margin-bottom: 20px;
      font-weight: 600;
    }

    nav a {
      color: rgba(255, 255, 255, 0.85);
      padding: 12px 20px;
      text-decoration: none;
      width: calc(100% - 30px);
      text-align: center;
      border-radius: 6px;
      transition: all 0.3s ease;
      font-size: 0.95rem;
      font-weight: 400;
      letter-spacing: 0.5px;
      border-left: 3px solid transparent;
    }

    nav a:hover {
      background: rgba(255, 255, 255, 0.06);
      color: #c9a96a;
      border-left: 3px solid #c9a96a;
    }

    /* ===== BANNER / HEADER ===== */
    header {
      background: linear-gradient(135deg, #0f2c4c 0%, #1b4a7a 100%);
      color: white;
      padding: 90px 20px 80px;
      text-align: center;
      position: relative;
      overflow: hidden;
    }

    header::before {
      content: "";
      position: absolute;
      top: -80px;
      left: 50%;
      transform: translateX(-50%);
      width: 450px;
      height: 450px;
      background: radial-gradient(circle, rgba(201,169,106,0.18), transparent 70%);
      border-radius: 50%;
      pointer-events: none;
    }

    header img {
      width: 220px;
      height: 220px;
      border-radius: 50%;
      border: 4px solid white;
      outline: 2px solid rgba(201, 169, 106, 0.6);
      outline-offset: 6px;
      object-fit: cover;
      margin-bottom: 25px;
      box-shadow: 0 15px 40px rgba(0, 0, 0, 0.35);
      transition: transform 0.4s ease, box-shadow 0.4s ease;
      position: relative;
      z-index: 1;
    }

    header img:hover {
      transform: scale(1.04);
      box-shadow: 0 20px 50px rgba(0, 0, 0, 0.5);
    }

    header h1 {
      font-size: 3rem;
      margin-bottom: 12px;
      position: relative;
      z-index: 1;
      color: #ffffff;
    }

    header p {
      font-size: 1.1rem;
      opacity: 0.85;
      font-weight: 300;
      letter-spacing: 1px;
      position: relative;
      z-index: 1;
      color: #c9a96a;
    }

    /* ===== SECTIONS ===== */
    section {
      padding: 70px 20px;
      max-width: 900px;
      margin: auto;
      opacity: 0;
      transform: translateY(20px);
      animation: fadeUp 0.8s ease forwards;
    }

    @keyframes fadeUp {
      to { opacity: 1; transform: translateY(0); }
    }

    section h2 {
      text-align: center;
      margin-bottom: 40px;
      color: #0f2c4c;
      font-size: 2.2rem;
      position: relative;
    }

    section h2::after {
      content: "";
      display: block;
      width: 60px;
      height: 2px;
      background: #c9a96a;
      margin: 14px auto 0;
    }

    /* About */
    #about p {
      line-height: 1.9;
      text-align: justify;
      color: #333;
      font-size: 1.02rem;
    }

    /* Skills */
    .skills-list {
      display: flex;
      flex-wrap: wrap;
      gap: 14px;
      justify-content: center;
    }

    .skill {
      background: #ffffff;
      color: #0f2c4c;
      padding: 12px 26px;
      border-radius: 4px;
      font-size: 0.9rem;
      font-weight: 500;
      letter-spacing: 0.5px;
      border: 1px solid rgba(15, 44, 76, 0.1);
      border-left: 3px solid #c9a96a;
      box-shadow: 0 2px 10px rgba(15, 44, 76, 0.05);
      transition: all 0.3s ease;
    }

    .skill:hover {
      transform: translateY(-3px);
      box-shadow: 0 8px 20px rgba(15, 44, 76, 0.12);
      border-left-color: #1b4a7a;
    }

    /* Projects */
    .projects-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
      gap: 22px;
    }

    .project-card {
      background: #ffffff;
      padding: 26px 22px;
      border-radius: 6px;
      border-left: 4px solid #c9a96a;
      box-shadow: 0 2px 12px rgba(15, 44, 76, 0.06);
      transition: all 0.3s ease;
    }

    .project-card:hover {
      transform: translateY(-5px);
      box-shadow: 0 12px 28px rgba(15, 44, 76, 0.12);
      border-left-color: #1b4a7a;
    }

    .project-card h3 {
      color: #0f2c4c;
      margin-bottom: 12px;
      font-size: 1.2rem;
    }

    .project-card p {
      color: #555;
      font-size: 0.93rem;
      line-height: 1.7;
    }

    /* ===== CONTACT ===== */
    .contact-info {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 14px;
      margin-bottom: 40px;
    }

    .contact-link {
      display: flex;
      align-items: center;
      gap: 12px;
      background: #ffffff;
      padding: 14px 26px;
      border-radius: 4px;
      text-decoration: none;
      color: #0f2c4c;
      font-weight: 500;
      font-size: 0.95rem;
      border: 1px solid rgba(15, 44, 76, 0.08);
      border-left: 3px solid #c9a96a;
      box-shadow: 0 2px 10px rgba(15, 44, 76, 0.05);
      transition: all 0.3s ease;
      word-break: break-all;
      letter-spacing: 0.3px;
    }

    .contact-link:hover {
      transform: translateY(-3px);
      box-shadow: 0 10px 22px rgba(15, 44, 76, 0.12);
      border-left-color: #1b4a7a;
    }

    .contact-icon {
      font-size: 0.75rem;
      font-weight: 700;
      letter-spacing: 1px;
      color: #c9a96a;
      font-family: 'Inter', sans-serif;
    }

    /* Contact Form */
    form {
      display: flex;
      flex-direction: column;
      gap: 16px;
      max-width: 520px;
      margin: auto;
    }

    form input, form textarea {
      padding: 14px 16px;
      border: 1px solid #d8dde3;
      border-radius: 4px;
      font-size: 0.95rem;
      font-family: 'Inter', sans-serif;
      background: #ffffff;
      color: #1a1a1a;
      transition: all 0.3s ease;
    }

    form input:focus, form textarea:focus {
      outline: none;
      border-color: #1b4a7a;
      box-shadow: 0 0 0 3px rgba(27, 74, 122, 0.1);
    }

    form button {
      background: transparent;
      border: 2px solid #1b4a7a;
      color: #1b4a7a;
      padding: 14px;
      border-radius: 4px;
      cursor: pointer;
      font-size: 0.85rem;
      font-family: 'Inter', sans-serif;
      font-weight: 600;
      letter-spacing: 2px;
      text-transform: uppercase;
      transition: all 0.3s ease;
      margin-top: 6px;
    }

    form button:hover {
      background: #1b4a7a;
      color: #ffffff;
      box-shadow: 0 8px 20px rgba(27, 74, 122, 0.25);
    }

    /* Footer */
    footer {
      background: #0f2c4c;
      color: rgba(255, 255, 255, 0.8);
      text-align: center;
      padding: 30px 20px;
      margin-top: 50px;
      line-height: 2;
      font-size: 0.85rem;
      letter-spacing: 0.5px;
      border-top: 2px solid #c9a96a;
    }

    footer a {
      color: #c9a96a;
      text-decoration: none;
      margin: 0 10px;
      transition: color 0.3s;
    }

    footer a:hover {
      color: #ffffff;
      text-decoration: underline;
    }

    /* ===== RESPONSIVE (Mobile) ===== */
    @media (max-width: 768px) {
      body {
        padding-left: 0;
        padding-top: 60px;
      }

      nav {
        flex-direction: row;
        width: 100%;
        height: 60px;
        justify-content: center;
        gap: 0;
        background: linear-gradient(90deg, #0f2c4c 0%, #1b4a7a 100%);
      }

      nav::before {
        display: none;
      }

      nav a {
        padding: 18px 14px;
        width: auto;
        margin: 0;
        border-radius: 0;
        font-size: 0.85rem;
        border-left: none;
        border-bottom: 3px solid transparent;
      }

      nav a:hover {
        border-left: none;
        border-bottom: 3px solid #c9a96a;
      }

      html {
        scroll-padding-left: 0;
        scroll-padding-top: 70px;
      }

      header {
        padding: 60px 15px 50px;
      }

      header img {
        width: 160px;
        height: 160px;
        border-width: 3px;
        outline-offset: 4px;
      }

      header h1 { font-size: 2rem; }
      header p { font-size: 0.95rem; }

      section h2 { font-size: 1.7rem; }

      .contact-link {
        font-size: 0.82rem;
        padding: 12px 18px;
      }
    }
  </style>
</head>
<body>

  <!-- ===== SIDEBAR NAVIGATION ===== -->
  <nav>
    <a href="#about">About</a>
    <a href="#skills">Skills</a>
    <a href="#projects">Projects</a>
    <a href="#contact">Contact</a>
  </nav>

  <!-- ===== BANNER ===== -->
  <header>
    <img src="https://i.imgur.com/7WPx97a.jpeg" alt="Profile Photo">
