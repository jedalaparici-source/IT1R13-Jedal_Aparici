  <!-- ===== CONTACT ===== -->
  <section id="contact">
    <h2>Contact</h2>

    <div class="contact-info">
      <a href="https://github.com/jedalaparici-source/IT1R13-Jedal_Aparici" target="_blank" class="contact-link">
        <span class="contact-icon">GH</span>
        <span>github.com/jedalaparici-source</span>
